{
  "name": "@jelleo/solana-security-standard",
  "version": "1.9.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Scan Solana/Anchor Rust code against the Solana Security Standard (SOL-0XX) — by Jelleo.",
  "bin": {
    "solana-security-standard": "bin.js",
    "sol-scan": "bin.js"
  },
  "main": "src/scanner.js",
  "files": [
    "bin.js",
    "src/",
    "rules.json",
    "README.md"
  ],
  "scripts": {
    "sync": "node scripts/sync-rules.js",
    "sync:semgrep": "node scripts/sync-semgrep.js",
    "sync:integrations": "node scripts/sync-integrations.js",
    "test": "node --test",
    "prepack": "node scripts/sync-rules.js",
    "prepublishOnly": "node scripts/sync-rules.js --check && node scripts/sync-semgrep.js --check && node scripts/sync-integrations.js --check && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "solana",
    "anchor",
    "security",
    "static-analysis",
    "audit",
    "sast",
    "sol-0xx",
    "solana-security-standard"
  ],
  "author": "Jelleo (https://jelleo.com)",
  "license": "MIT",
  "homepage": "https://github.com/Copenhagen0x/solana-security-standard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Copenhagen0x/solana-security-standard.git",
    "directory": "cli"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  }
}
